        "title": [
          "核对 ",
          {
            "parameterId": "environment"
          },
          " 的维护目标"
        ],
        "description": [
          "目标版本：",
          {
            "parameterId": "version"
          },
          "\n确认维护范围、维护窗口和人工审批。"
        ],
        "commands": []
      },
      {
        "id": "s2-package",
        "title": [
          "检查补丁包"
        ],
        "description": [
          "核对文件是否存在，并比对发布清单中的 SHA256。"
        ],
        "commands": [
          {
            "id": "package-info",
            "text": [
              "Get-Item -LiteralPath '",
              {
                "parameterId": "packagePath"
              },
              "'"
            ]
          },
          {
            "id": "package-hash",
            "text": [
              "Get-FileHash -LiteralPath '",
              {
                "parameterId": "packagePath"
              },
              "' -Algorithm SHA256"
            ]
          }
        ]
      },
      {
        "id": "s3-backup",
        "title": [
          "确认已有可用备份"
        ],
        "description": [
          "在外部工具完成备份，并确认恢复方式。\n当前目录：",
          {
            "parameterId": "targetDir"
          }
        ],
        "commands": []
      },
      {
        "id": "s4-apply",
        "title": [
          "在外部工具应用补丁"
        ],
        "description": [
          "将 ",
          {
            "parameterId": "version"
          },
          " 应用到 ",
          {
            "parameterId": "environment"
          },
          "。\n此步骤中的 Demo-PatchTool 为虚构示例工具。"
        ],
        "commands": [
          {
            "id": "apply-patch",
            "text": [
              "Demo-PatchTool apply --package \"",
              {
                "parameterId": "packagePath"
              },
              "\" --target \"",
              {
                "parameterId": "targetDir"
              },
              "\" --version \"",
              {
                "parameterId": "version"
              },
              "\""
            ]
          }
        ]
      },
      {
        "id": "s5-verify",
        "title": [
          "核对 ",
          {
            "parameterId": "environment"
          },
          " 的维护结果"
        ],
        "description": [
          "核对版本为 ",
          {
            "parameterId": "version"
          },
          "，检查服务状态及业务抽查结果。\n按需添加评论和截图，完成后实例仍保留在当前列表，手动归档后移到归档列表。"
        ],
        "commands": [
          {
            "id": "read-version",
            "text": [
              "Get-Content -LiteralPath '",
              {
                "parameterId": "targetDir"
              },
              "\\VERSION.txt'"
            ]
          }
        ]
      }
    ]
