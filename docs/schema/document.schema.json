{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runbook Work Document v2",
  "$comment": "Reusable content carried by ordinary work records. Runtime state and history remain separate fields; native validation enforces identity, scope and workflow constraints.",
  "$ref": "#/$defs/document",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "text": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameterId"
            ],
            "properties": {
              "parameterId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        ]
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "defaultValue"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "defaultValue": {
          "type": "string"
        },
        "ownerId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "commands"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "minItems": 1
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "commands": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "groupId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "$comment": "May be empty for an untitled group; native validation limits UTF-8 bytes to 1024 and rejects NUL."
        },
        "description": {
          "type": "string",
          "$comment": "Optional plain multiline block description; native validation limits UTF-8 bytes to 1 MiB and rejects NUL."
        },
        "sourceBlockId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters",
        "steps"
      ],
      "properties": {
        "parameters": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    }
  }
}
